# Copy to .env and adjust for your environment.
# Expo inlines EXPO_PUBLIC_* at build / start time.

# Backend API (Good Food Pro)
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Demo mode: pre-fills login (set false for production builds)
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_DEMO_EMAIL=demo@customer.com
EXPO_PUBLIC_DEMO_PASSWORD=demo123

# Optional integrations
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Map provider: osm (default, free) | maptiler | mapbox | google
EXPO_PUBLIC_MAP_PROVIDER=osm
EXPO_PUBLIC_MAPTILER_API_KEY=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
