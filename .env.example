# App (Expo — EXPO_PUBLIC_* inlined at build time)
EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_DEMO_EMAIL=demo@customer.com
EXPO_PUBLIC_DEMO_PASSWORD=demo123
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Map provider: osm (default, free) | maptiler | mapbox | google
EXPO_PUBLIC_MAP_PROVIDER=osm
EXPO_PUBLIC_MAPTILER_API_KEY=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# GitHub Repository Variables (Settings → Variables → Actions)
# EXPO_PUBLIC_API_URL=https://your-domain.com/api
# EXPO_PUBLIC_DEMO_MODE=true
# EXPO_PUBLIC_DEMO_EMAIL=demo@customer.com
# EXPO_PUBLIC_DEMO_PASSWORD=demo123
# PUBLIC_SITE_URL=https://your-domain.com
# APK_FILENAME=GoodFoods.apk
# VPS_DOWNLOADS_DIR=/var/www/html/downloads

# GitHub Secrets (Settings → Secrets → Actions)
# EXPO_TOKEN=
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=   (optional)
# Map tiles — choose one provider (default: osm, no key needed)
# EXPO_PUBLIC_MAP_PROVIDER=osm          (free, OpenStreetMap)
# EXPO_PUBLIC_MAP_PROVIDER=maptiler     → set EXPO_PUBLIC_MAPTILER_API_KEY
# EXPO_PUBLIC_MAP_PROVIDER=mapbox       → set EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN
# EXPO_PUBLIC_MAP_PROVIDER=google       → set EXPO_PUBLIC_GOOGLE_MAPS_API_KEY
# EXPO_PUBLIC_MAPTILER_API_KEY=         (optional)
# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=      (optional)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=      (optional)
# VPS_HOST=
# VPS_USER=
# VPS_SSH_KEY=
