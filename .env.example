# App (Expo — EXPO_PUBLIC_* inlined at build time)
EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_DEMO_EMAIL=demo@customer.com
EXPO_PUBLIC_DEMO_PASSWORD=demo123
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_MAPTILER_API_KEY=

# GitHub Repository Variables (Settings → Variables → Actions)
# EXPO_PUBLIC_API_URL=https://your-domain.com/api
# EXPO_PUBLIC_DEMO_MODE=true
# EXPO_PUBLIC_DEMO_EMAIL=demo@customer.com
# EXPO_PUBLIC_DEMO_PASSWORD=demo123
# PUBLIC_SITE_URL=https://your-domain.com
# APK_FILENAME=GoodFoods.apk
# VPS_DOWNLOADS_DIR=/var/www/html/downloads

# GitHub Secrets (Settings → Secrets → Actions)
# EXPO_TOKEN=
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=   (optional)
# EXPO_PUBLIC_MAPTILER_API_KEY=         (optional)
# VPS_HOST=
# VPS_USER=
# VPS_SSH_KEY=
