{
  "expo": {
    "name": "Good Food Pro Customer",
    "icon": "./assets/images/logo512.png",
    "splash": {
      "image": "./assets/images/splash-screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "version": "1.0.0",
    "slug": "good-food-customer",
    "scheme": "goodfoods",
    "ios": {
      "bundleIdentifier": "com.goodfoods.goodfoods",
      "buildNumber": "1.0.0"
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "package": "com.goodfoods.goodfoods",
      "versionCode": 1
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Good Food to access your photos to update your profile picture.",
          "cameraPermission": "Allow Good Food to access your camera to take a profile photo."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.goodfoods.goodfoods"
        }
      ]
    ]
  }
}
